generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String
  role                 String    @default("architecte")
  company              String?
  avatarUrl            String?
  notifyEmail          Boolean   @default(true)
  notifyAnalysisDone   Boolean   @default(true)
  active               Boolean   @default(true)
  createdByAdminId     String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  projects             Project[]
}

model PlatformSettings {
  id              Int      @id @default(1)
  prixCimentSac   Int      @default(5500)
  prixParpaing    Int      @default(350)
  prixFerBarre    Int      @default(6500)
  prixSableM3     Int      @default(8000)
  prixGravierM3   Int      @default(10000)
  prixBoisM3      Int      @default(150000)
  prixToleFeuille Int      @default(4500)
  updatedAt       DateTime @updatedAt
}

model Project {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  buildingType    String
  location        String
  levels          Int
  approxSurface   Float
  description     String   @db.Text
  status          String   @default("brouillon")
  planFile        Json?
  detectedData    Json?
  verifiedData    Json?
  technicalParams Json
  result          Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}
