APP_NAME="Build Estimate AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite by default for local dev (zero external service required).
# Switch to mysql/pgsql in staging/production by changing DB_CONNECTION
# and filling in the host/port/database/credentials below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- React SPA integration -----------------------------------------------
# SANCTUM_STATEFUL_DOMAINS also drives config/cors.php's allowed origins, so
# it lists a few Vite fallback ports (5173 already taken → 5174, 5175...)
# rather than just the canonical FRONTEND_URL port.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:5175,localhost:5176,127.0.0.1:5173

# --- AI provider (Phase 4) -------------------------------------------------
# "mock" requires no external key and is what tests/seeders use.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Payment provider (Phase 7) ---------------------------------------------
# "mock" requires no external key and is what tests/seeders use. Real
# providers (stripe/paystack/flutterwave) are declared as extension points
# in config/payment.php but are not wired to a live account in this build.
PAYMENT_PROVIDER=mock

# --- Demo account (Database\Seeders\DemoUserSeeder) -------------------------
# This account's usage quotas are always bypassed (App\Enums\AccountType::
# Demo — see UsageService::ensureCanConsume). Change these before deploying
# publicly; never leave the default password on a real deployment.
DEMO_USER_EMAIL=demo@buildestimate.ai
DEMO_USER_PASSWORD=password

# --- Build Estimate AI domain config ---------------------------------------
BUILD_ESTIMATE_MAX_UPLOAD_KB=25600
BUILD_ESTIMATE_SUPPORTED_FORMATS=pdf,jpg,jpeg,png
BUILD_ESTIMATE_DEFAULT_CURRENCY=XOF
BUILD_ESTIMATE_SUPPORTED_CURRENCIES=XOF,EUR,USD
BUILD_ESTIMATE_ANALYSIS_TIMEOUT=120
BUILD_ESTIMATE_CONFIDENCE_THRESHOLD=0.85
BUILD_ESTIMATE_STORAGE_DISK=local
BUILD_ESTIMATE_QUEUE=default
BUILD_ESTIMATE_CALCULATION_VERSION=1.0
